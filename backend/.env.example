# Server Port Configuration
PORT=5000

# Database Connection (MongoDB URI)
MONGODB_URI=your_mongodb_connection_string

# Authentication Security Settings
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# Institution Eligibility Rules
INSTITUTE_NAME=NIT DURGAPUR
INSTITUTE_ELIGIBILITY=NIT_DURGAPUR_ONLY
INSTITUTE_EMAIL_DOMAIN=@nitdgp.ac.in

# Cloudinary Credentials (For Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gmail SMTP Credentials (For Nodemailer Email Notifications)
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_character_google_app_password

# Initial Admin Seeder Credentials
ADMIN_EMAIL=your_desired_admin_email@example.com
ADMIN_PASSWORD=your_desired_admin_password